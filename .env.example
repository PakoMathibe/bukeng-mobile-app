# .env.example
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Payment Integration - PayShap (merchant settlement)
PAYSHAP_API_KEY=your-payshap-api-key

# Payment Integration - DebiCheck (repayment collection)
DEBICHECK_API_KEY=your-debicheck-api-key
DEBICHECK_WEBHOOK_SECRET=your-webhook-secret

# Environment
NEXT_PUBLIC_APP_ENV=development